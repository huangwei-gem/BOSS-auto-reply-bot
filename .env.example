# BOSS 自动回复机器人环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# 主 API（agnes-2.5-flash）
AI_API_KEY_1=your_api_key_here
AI_MODEL_1=agnes-2.5-flash
AI_API_KEY_2=your_api_key_here
AI_MODEL_2=agnes-2.5-flash
AI_BASE_URL=https://apihub.agnes-ai.com/v1

# 备用 API（deepseek-v4-flash）
AI_BACKUP_KEY_1=your_backup_key_here
AI_BACKUP_MODEL_1=deepseek-v4-flash
AI_BACKUP_KEY_2=your_backup_key_here
AI_BACKUP_MODEL_2=deepseek-v4-flash
AI_BACKUP_BASE_URL=https://token.sensenova.cn/v1
